{
  "version": "1.1",
  "rules": [
    {
      "id": "rule_payroll",
      "name": "Payroll / Salaries",
      "priority": 10,
      "type": "categorize",
      "conditions": {
        "operator": "OR",
        "tests": [
          { "field": "description", "op": "contains_any", "values": ["PAYROLL", "SALARY", "SALARIES", "WAGES", "BACS PAYROLL", "MONTHLY PAY"] },
          { "field": "description", "op": "regex", "pattern": "(?i)pay\\s?roll|salari" }
        ]
      },
      "action": {
        "category": "Staff Costs",
        "pl_line": "5100 - Wages & Salaries",
        "cf_type": "operating_outflow",
        "confidence": 0.97
      }
    },
